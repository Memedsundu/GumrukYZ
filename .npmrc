# Use hoisted node_modules (no symlinks for regular packages).
# Required for Vercel serverless — pnpm's default isolated symlink structure
# causes "symlinked directories" errors in Vercel's function packager.
node-linker=hoisted
shamefully-hoist=true
# Auto-confirm module directory purge when switching linkers (required for CI/non-TTY).
confirm-module-purge=false
