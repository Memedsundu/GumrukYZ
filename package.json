{
  "name": "gumrukyz",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @gumrukyz/db migrate:dev",
    "db:push": "pnpm --filter @gumrukyz/db push",
    "db:seed": "pnpm --filter @gumrukyz/db seed",
    "db:bootstrap-regulations": "pnpm --filter @gumrukyz/db bootstrap-regulations",
    "db:studio": "pnpm --filter @gumrukyz/db studio",
    "rules:test": "pnpm --filter @gumrukyz/rules test:fixtures",
    "test:urgent-fixes": "node scripts/verify-urgent-fixes.mjs",
    "deploy:prod": "vercel deploy --prod --yes",
    "smoke:production": "node scripts/smoke-production.mjs",
    "verify:production-env": "node scripts/verify-production-env.mjs",
    "load-test:readiness": "node scripts/load-test-readiness.mjs",
    "finish:scalability-production": "node scripts/finish-scalability-production.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "eslint": "^9.39.4",
    "typescript-eslint": "^8.59.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.0.8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "@prisma/client",
      "prisma",
      "esbuild",
      "lightningcss",
      "@clerk/shared",
      "@next/swc-darwin-arm64",
      "@next/swc-linux-x64-gnu"
    ]
  }
}
